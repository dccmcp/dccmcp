{
  "name": "dccmcp-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "DCCMCP — MCP servers for creative and engineering software",
  "license": "SEE LICENSE IN LICENSING.md",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "gen": "node scripts/gen-contract.mjs",
    "check:boundary": "node scripts/check-license-boundary.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "check": "npm run check:boundary && npm run check:generated",
    "publish:all": "bash scripts/publish-all.sh",
    "publish:dry-run": "bash scripts/publish-all.sh --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dccmcp/dccmcp.git"
  },
  "homepage": "https://dccmcp.com",
  "engines": {
    "node": ">=18"
  }
}
